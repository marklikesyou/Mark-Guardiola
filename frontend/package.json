{
  "name": "markguardiola-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts --default-non-nullable=false && node scripts/strip-generated-comments.mjs src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "@tanstack/react-query": "^5.90.5",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6"
  }
}
